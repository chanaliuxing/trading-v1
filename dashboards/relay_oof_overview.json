        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 31,
      "options": {
        "footer": {
          "fields": "",
          "reducer": [
            "count"
          ]
        },
        "showHeader": true
      },
      "targets": [
        {
          "query": "SELECT ts, run_id, use_relay, round(auc,4) AS auc, round(mean_val,4) AS mean_val, params_json FROM trading.runs WHERE symbol='${symbol}' AND $__timeFilter(ts) ORDER BY ts DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "title": "Recent Runs — ${symbol}",
      "type": "table"
    }
