        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      },
      "targets": [
        {
          "query": "SELECT anyLast(run_id) AS run_id FROM (SELECT run_id, max(updated_at) AS last_upd FROM trading.oof_lstm_h5 WHERE symbol='${symbol}' GROUP BY run_id ORDER BY last_upd DESC LIMIT 1)",
