          "query": "SELECT toStartOfInterval(ts, INTERVAL $__interval SECOND) AS t, avg(lstm_oof_h5 IS NOT NULL) * 100 AS coverage_pct FROM trading.features_1m_with_oof WHERE symbol='${symbol}' AND $__timeFilter(ts) GROUP BY t ORDER BY t",
          "refId": "A"
        }
      ],
      "title": "Coverage Over Time — ${symbol}",
