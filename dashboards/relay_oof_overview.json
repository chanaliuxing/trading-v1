        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "query": "SELECT toStartOfInterval(ts, INTERVAL $__interval SECOND) AS t, sum(lstm_oof_h5 IS NULL) AS null_cnt FROM trading.features_1m_with_oof WHERE symbol='${symbol}' AND $__timeFilter(ts) GROUP BY t ORDER BY t",
          "refId": "A"
