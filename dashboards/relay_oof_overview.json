        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 21,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "query": "SELECT symbol, anyLast(run_id) AS run_id, max(updated_at) AS last_updated FROM trading.oof_lstm_h5 GROUP BY symbol ORDER BY last_updated DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Latest OOF Versions",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "$DS_CH"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
