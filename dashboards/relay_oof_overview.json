      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "query": "SELECT symbol, round(avg(lstm_oof_h5 IS NOT NULL) * 100, 2) AS coverage_pct FROM trading.features_1m_with_oof WHERE $__timeFilter(ts) GROUP BY symbol ORDER BY coverage_pct ASC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Bottom Coverage Symbols",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
