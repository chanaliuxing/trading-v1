        "showThresholds": false
      },
      "targets": [
        {
          "query": "SELECT avg(lstm_oof_h5 IS NOT NULL) * 100 AS coverage_pct FROM trading.features_1m_with_oof WHERE symbol='${symbol}' AND $__timeFilter(ts)",
          "refId": "A"
        }
      ],
      "title": "OOF Coverage — ${symbol}",
