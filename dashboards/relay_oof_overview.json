      "targets": [
        {
          "query": "SELECT toFloat64((toUnixTimestamp(now()) - toUnixTimestamp(max(updated_at))) / 60.0) AS lag_minutes FROM trading.oof_lstm_h5 WHERE symbol='${symbol}'",
          "refId": "A"
        }
      ],
      "title": "OOF Lag Minutes — ${symbol}",
      "type": "stat"
