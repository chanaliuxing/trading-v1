  "panels": [
    {
      "type": "row",
      "title": "\ud83d\udcca Sessions Overview (\u4f1a\u8bdd\u6982\u89c8)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "\ud83d\udcca Total Sessions (\u603b\u4f1a\u8bdd\u6570)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT count(DISTINCT session_id) as total_sessions\nFROM llm.llm_sessions\nWHERE start_ts_ny >= now() - INTERVAL 7 DAY\n"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "\ud83d\udd04 Running Sessions (\u8fd0\u884c\u4e2d)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT count(*) as running_sessions\nFROM llm.llm_sessions\nWHERE status = 'RUNNING'\n  AND start_ts_ny >= now() - INTERVAL 7 DAY\n"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "\u26a0\ufe0f Zombie Sessions (\u50f5\u5c38\u4f1a\u8bdd >24h)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT count(*) as zombie_sessions\nFROM llm.llm_sessions\nWHERE status = 'RUNNING'\n  AND (now() - start_ts_ny) > 86400  -- 24 hours = 86400 seconds\n"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 10,
                "color": "orange"
              },
              {
                "value": 50,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background"
      }
    },
