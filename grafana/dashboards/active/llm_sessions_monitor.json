    {
      "type": "piechart",
      "title": "\ud83c\udfaf Decisions by Action (\u6309\u51b3\u7b56\u7c7b\u578b)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    JSONExtractString(decision_json, 'action') as action,\n    count(*) as count\nFROM llm.llm_decisions\nWHERE ts_ny >= now() - INTERVAL 7 DAY\nGROUP BY action\nORDER BY count DESC\n"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 15,
      "options": {
        "legend": {
