              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mode"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "start_time",
            "desc": true
          }
