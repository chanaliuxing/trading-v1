    {
      "type": "table",
      "title": "\u26a0\ufe0f Zombie Sessions (\u50f5\u5c38\u4f1a\u8bdd - RUNNING >24h)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    formatDateTime(start_ts_ny, '%Y-%m-%d %H:%M:%S ET') as start_time,\n    round((now() - start_ts_ny) / 3600, 1) as hours_running,\n    substring(session_id, 1, 12) as session_id,\n    bot_id,\n    model,\n    mode,\n    symbols,\n    status\nFROM llm.llm_sessions\nWHERE status = 'RUNNING'\n  AND (now() - start_ts_ny) > 86400  -- 24 hours\nORDER BY start_ts_ny ASC\nLIMIT 100\n"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 18,
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hours_running"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": 24,
                      "color": "yellow"
                    },
                    {
                      "value": 48,
                      "color": "orange"
                    },
                    {
                      "value": 168,
                      "color": "red"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mode"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "hours_running",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "\ud83d\udccb Recent Sessions Table (\u6700\u8fd1\u4f1a\u8bdd\u5217\u8868)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    formatDateTime(start_ts_ny, '%Y-%m-%d %H:%M:%S') as start_time,\n    substring(session_id, 1, 8) as session_short,\n    bot_id,\n    model,\n    symbols,\n    mode,\n    status,\n    close_reason\nFROM llm.llm_sessions\nWHERE start_ts_ny >= now() - INTERVAL 7 DAY\nORDER BY start_ts_ny DESC\nLIMIT 50\n"
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "id": 19,
      "fieldConfig": {
        "overrides": [
