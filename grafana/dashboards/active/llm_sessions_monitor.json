      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    mode,\n    count(*) as sessions\nFROM llm.llm_sessions\nWHERE start_ts_ny >= now() - INTERVAL 7 DAY\nGROUP BY mode\nORDER BY sessions DESC\n"
