    {
      "type": "timeseries",
      "title": "\ud83d\udcca Sessions Started Over Time (\u4f1a\u8bdd\u542f\u52a8\u8d8b\u52bf)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    toStartOfHour(start_ts_ny) as time,\n    count(*) as sessions_started\nFROM llm.llm_sessions\nWHERE start_ts_ny >= now() - INTERVAL 7 DAY\nGROUP BY time\nORDER BY time\n"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 8,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "\ud83d\udd04 Active Sessions Count (\u6d3b\u8dc3\u4f1a\u8bdd\u6570)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    toStartOfHour(start_ts_ny) as time,\n    status,\n    count(*) as session_count\nFROM llm.llm_sessions\nWHERE start_ts_ny >= now() - INTERVAL 7 DAY\nGROUP BY time, status\nORDER BY time\n"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 9,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RUNNING session_count"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "\ud83e\udd16 Bot & Model Distribution (Bot \u548c\u6a21\u578b\u5206\u5e03)",
