    {
      "type": "table",
      "title": "\ud83d\udccb Recent Plans (\u8fd1\u671f\u8ba1\u5212)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
