      "id": 17,
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    ts_ny,\n    kind,\n    session,\n    provider,\n    model,\n    duration_ms,\n    trading_universe_count,\n    arrayStringConcat(input_keys, ', ') as inputs\nFROM llm.ai_brain_calls\nWHERE ts_ny >= $__fromTime AND ts_ny <= $__toTime\n  AND session LIKE '${session}'\nORDER BY ts_ny DESC\nLIMIT 50\n"
