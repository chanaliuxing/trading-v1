          "refId": "A",
          "rawSql": "\nSELECT\n    toStartOfHour(ts_ny) as time,\n    kind,\n    round(avg(duration_ms), 1) as avg_latency_ms\nFROM llm.ai_brain_calls\nWHERE ts_ny >= now() - INTERVAL 7 DAY\nGROUP BY time, kind\nORDER BY time\n"
