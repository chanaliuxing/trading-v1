      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 4
      },
      "id": 17,
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    symbol,\n    sum(qty * price) as volume\nFROM llm.llm_fills\nWHERE toDate(ts_ny) = today()\n  AND symbol LIKE '${symbol}'\nGROUP BY symbol\nORDER BY volume DESC\n"
        }
