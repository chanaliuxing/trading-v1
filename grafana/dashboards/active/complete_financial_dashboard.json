    {
      "type": "barchart",
      "title": "\ud83d\udcca Fill Volume by Symbol (\u5404\u80a1\u7968\u6210\u4ea4\u91cf)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
