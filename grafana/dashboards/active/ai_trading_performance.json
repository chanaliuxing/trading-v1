        "x": 0,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "rawSql": "\nSELECT\n    formatDateTime(ts_ny, '%Y-%m-%d %H:%M:%S ET') as last_update,\n    round((now() - ts_ny) / 60, 0) as minutes_ago\nFROM llm.ibkr_account_realtime\nORDER BY ts_ny DESC\nLIMIT 1\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "pattern": ".*",
                "result": {
                  "text": "${__field.name}: ${__value} min ago"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 60,
                "color": "orange"
              },
              {
                "value": 360,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
