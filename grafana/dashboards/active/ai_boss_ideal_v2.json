        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "rawSql": "\nSELECT\n    value as events,\n    CASE\n        WHEN value = 0 THEN 'Active'\n        WHEN value < 5 THEN 'Warning'\n        ELSE 'TRIPPED'\n    END as status\nFROM trading.ai_trader_dash_metrics\nWHERE name = 'guardian_events' AND date = today()\nORDER BY ts DESC LIMIT 1\n",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udee1\ufe0f Guardian Status (\u5b88\u62a4\u8005)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "description": "\u26a0\ufe0f PLACEHOLDER\n\n\u9700\u8981: equity_pnl_snapshots",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "currencyUSD"
        }
      },
      "gridPos": {
        "h": 3,
        "w": 7,
        "x": 17,
        "y": 4
      },
      "id": 7,
      "targets": [
        {
          "rawSql": "\n-- \u26a0\ufe0f PLACEHOLDER\nSELECT\n    ts as time,\n    equity as value\nFROM trading.equity_pnl_snapshots\nWHERE ts > now() - INTERVAL 24 HOUR\nORDER BY ts\n",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udcb5 Account Equity (24h)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 8,
      "title": "\ud83e\udde0 Row 2: AI \u6a21\u578b\u8868\u73b0 (Is the Brain Smart?)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "description": "\u26a0\ufe0f PLACEHOLDER\n\n\u9700\u8981: trading_signals \u8868\n\n\u663e\u793a\u6a21\u578b\u4fe1\u53f7 (-1\u52301) \u7684\u5206\u5e03\n\u660e\u786e\u4fe1\u53f7 = \u5206\u5e03\u5728\u00b11\u9644\u8fd1\n\u72b9\u8c6b\u4e0d\u51b3 = \u96c6\u4e2d\u57280\u9644\u8fd1",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 9,
      "targets": [
        {
          "rawSql": "\n-- \u26a0\ufe0f PLACEHOLDER - Need trading_signals table\nSELECT\n    round(signal, 1) as signal_bucket,\n    count() as frequency\nFROM trading.trading_signals\nWHERE ts > now() - INTERVAL $time_range\n  AND strategy_id LIKE '$strategy_id'\n  AND symbol LIKE '$symbol'\nGROUP BY signal_bucket\nORDER BY signal_bucket\n",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udcca Signal Distribution (\u4fe1\u53f7\u5206\u5e03)",
      "type": "histogram"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "description": "\u26a0\ufe0f PLACEHOLDER\n\n\u9700\u8981: trading_signals \u8868\n\n\u663e\u793a\u6a21\u578b\u7f6e\u4fe1\u5ea6 (0\u52301) \u7684\u5206\u5e03\n\u9ad8\u7f6e\u4fe1\u5ea6 = \u6a21\u578b\u786e\u5b9a\n\u4f4e\u7f6e\u4fe1\u5ea6 = \u6a21\u578b\u4e0d\u786e\u5b9a",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 10,
      "targets": [
        {
          "rawSql": "\n-- \u26a0\ufe0f PLACEHOLDER\nSELECT\n    round(confidence, 1) as conf_bucket,\n    count() as frequency\nFROM trading.trading_signals\nWHERE ts > now() - INTERVAL $time_range\n  AND strategy_id LIKE '$strategy_id'\n  AND symbol LIKE '$symbol'\nGROUP BY conf_bucket\nORDER BY conf_bucket\n",
          "refId": "A"
        }
      ],
      "title": "\ud83c\udfaf Confidence Distribution (\u7f6e\u4fe1\u5ea6\u5206\u5e03)",
      "type": "histogram"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "description": "\u26a0\ufe0f PLACEHOLDER\n\n\u9700\u8981: trading_signals + outcome \u6570\u636e\n\n\u9a8c\u8bc1\u6a21\u578b\u6709\u6548\u6027\u7684\u5173\u952e!\n\u9ad8\u7f6e\u4fe1\u5ea6\u4ea4\u6613\u5e94\u8be5\u6709\u66f4\u9ad8\u7684\u80dc\u7387\u548c\u76c8\u4e8f",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 11,
      "targets": [
        {
          "rawSql": "\n-- \u26a0\ufe0f PLACEHOLDER\nSELECT\n    floor(confidence * 10) / 10 as conf_range,\n    count() as total_trades,\n    countIf(outcome > 0) as wins,\n    round(countIf(outcome > 0) / count() * 100, 1) as win_rate,\n    round(avg(outcome), 2) as avg_pnl\nFROM trading.trading_signals\nWHERE executed = 1\n  AND outcome IS NOT NULL\n  AND ts > now() - INTERVAL $time_range\n  AND strategy_id LIKE '$strategy_id'\n  AND symbol LIKE '$symbol'\nGROUP BY conf_range\nORDER BY conf_range\n",
          "refId": "A"
        }
      ],
      "title": "\ud83c\udfc6 High-Confidence Performance (\u9ad8\u7f6e\u4fe1\u5ea6\u8868\u73b0)",
      "type": "barchart"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 12,
      "title": "\ud83d\udcbc Row 3: \u6295\u8d44\u7ec4\u5408\u98ce\u9669 (What Are We Betting On?)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "description": "\u26a0\ufe0f PLACEHOLDER\n\n\u9700\u8981: portfolio_snapshots \u8868\n\n\u5feb\u901f\u8bc6\u522b:\n- \u660e\u661f\u7b56\u7565 (\u76c8\u5229\u591a)\n- \u7d2f\u8d58\u7b56\u7565 (\u4e8f\u635f\u591a)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 13,
      "targets": [
        {
          "rawSql": "\n-- \u26a0\ufe0f PLACEHOLDER\nSELECT\n    strategy_id,\n    sum(pnl) as total_pnl,\n    count() as trades,\n    round(avg(pnl), 2) as avg_pnl_per_trade\nFROM trading.portfolio_snapshots\nWHERE date >= today() - INTERVAL $time_range\n  AND strategy_id LIKE '$strategy_id'\nGROUP BY strategy_id\nORDER BY total_pnl DESC\n",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udcca Strategy PnL (\u5404\u7b56\u7565\u76c8\u4e8f)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "description": "\u26a0\ufe0f PLACEHOLDER\n\n\u9700\u8981: positions_snapshots \u8868\n\n\u7cbe\u786e\u4e86\u89e3:\n- \u94b1\u653e\u5728\u54ea\u91cc\n- \u6bcf\u4e2a\u6301\u4ed3\u7684\u76c8\u4e8f",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 14,
      "targets": [
        {
          "rawSql": "\n-- \u26a0\ufe0f PLACEHOLDER\nSELECT\n    symbol,\n    qty,\n    entry_price,\n    current_price,\n    unrealized_pnl,\n    round((current_price - entry_price) / entry_price * 100, 2) as pnl_pct,\n    strategy_id\nFROM trading.positions_snapshots\nWHERE date = today()\n  AND ts = (SELECT max(ts) FROM trading.positions_snapshots WHERE date = today())\n  AND strategy_id LIKE '$strategy_id'\n  AND symbol LIKE '$symbol'\nORDER BY abs(unrealized_pnl) DESC\n",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udccb Current Positions (\u5f53\u524d\u6301\u4ed3)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 15,
      "title": "\u26a1 Row 4: \u4ea4\u6613\u6267\u884c (Are We Trading Efficiently?)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "description": "\u26a0\ufe0f PLACEHOLDER\n\n\u9700\u8981: fills_live + order_events\n\n\u6ed1\u70b9 = \u9690\u6027\u6210\u672c\n\u8fc7\u9ad8\u6ed1\u70b9\u4f1a\u4e25\u91cd\u4fb5\u8680\u5229\u6da6",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 5
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 16,
      "targets": [
        {
          "rawSql": "\n-- \u26a0\ufe0f PLACEHOLDER\nSELECT\n    f.ts as time,\n    (f.fill_price - o.limit_price) / o.limit_price * 10000 as slippage_bps,\n    o.symbol\nFROM trading.fills_live f\nJOIN trading.order_events o ON f.order_id = o.order_id\nWHERE f.ts > now() - INTERVAL $time_range\n  AND o.order_type = 'LMT'\n  AND o.strategy_id LIKE '$strategy_id'\n  AND o.symbol LIKE '$symbol'\nORDER BY f.ts\n",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udcb8 Slippage Analysis (\u6ed1\u70b9\u5206\u6790)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "description": "\u26a0\ufe0f PLACEHOLDER\n\n\u9700\u8981: exec_events \u8868\n\n\u663e\u793a\u8f6c\u5316\u7387:\nAI\u51b3\u7b56 \u2192 \u98ce\u63a7 \u2192 \u63d0\u4ea4 \u2192 \u6210\u4ea4",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 17,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "rawSql": "\n-- \u26a0\ufe0f PLACEHOLDER\nSELECT\n    stage,\n    count(DISTINCT decision_id) as decisions\nFROM trading.exec_events\nWHERE date >= today() - INTERVAL $time_range\n  AND details LIKE '%$strategy_id%'\n  AND details LIKE '%$symbol%'\nGROUP BY stage\nORDER BY\n    CASE stage\n        WHEN 'GENERATED' THEN 1\n        WHEN 'RISK_CHECK' THEN 2\n        WHEN 'SUBMITTED' THEN 3\n        WHEN 'FILLED' THEN 4\n        WHEN 'REJECTED' THEN 5\n    END\n",
          "refId": "A"
        }
      ],
      "title": "\ud83d\udd3d Decision Funnel (\u51b3\u7b56\u6f0f\u6597)",
      "type": "bargauge"
    }
  ],
