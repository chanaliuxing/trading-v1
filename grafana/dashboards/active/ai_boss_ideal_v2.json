      "targets": [
        {
          "rawSql": "\n-- \u4eca\u65e5 + \u672c\u5468 + \u672c\u6708 + \u603b\u8ba1\u76c8\u4e8f\n-- \u26a0\ufe0f PLACEHOLDER - Need equity_pnl_snapshots data\nSELECT\n    anyLast(realized_pnl) + anyLast(unrealized_pnl) as total_pnl\nFROM trading.equity_pnl_snapshots\nWHERE date = today()\n-- Fallback: show 0 if no data\nUNION ALL\nSELECT 0 as total_pnl\nLIMIT 1\n",
