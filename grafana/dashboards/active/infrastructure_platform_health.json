    {
      "type": "row",
      "title": "Data Flow & Backfill",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Log Event Rate (by level)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (rate({job=\"trader\"} | json | __error__=\"\" [1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Log Rate (by strategy)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (strategy) (rate({job=\"trader\"} | json | __error__=\"\" | strategy!=\"\" [$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "row",
      "title": "Data Quality & Gaps",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Backfill Status",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "h": 7,
        "w": 14,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT ts, symbol, resolution, gap, last_err FROM trading.backfill_status ORDER BY ts DESC LIMIT 20",
          "format": 1,
          "queryType": "sql",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Latest backfill records from ClickHouse (empty = healthy)"
    },
    {
      "id": 13,
      "type": "text",
      "title": "Observability Gaps",
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 15
      },
      "options": {
        "mode": "markdown",
        "content": "- Prometheus exporters for container/host metrics not detected.\n- Kafka consumer lag metrics missing (`kafka_topic_lag`).\n- Redis/Postgres health currently inferred from logs only."
      }
    },
    {
      "type": "row",
      "title": "Current System Issues",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 35,
      "type": "table",
      "title": "Active Issues (10m)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (event) (count_over_time({job=\"trader\"} | json | __error__=\"\" | level =~ \"error|warning\" [10m])))",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "event": "Issue Type",
              "Value": "Count (10m)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Count (10m)",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 41,
      "type": "table",
