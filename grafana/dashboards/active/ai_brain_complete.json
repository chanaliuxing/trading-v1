      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          },
          "queryType": "sql",
          "rawSql": "\nSELECT concat(\n    '⏰ 时间: ', formatDateTime(ts_ny, '%Y-%m-%d %H:%i'), '\\n\\n',\n    '🔍 诊断: ', JSONExtractString(output_json, 'diagnosis'), '\\n\\n',\n    '📝 含义:\\n',\n    CASE JSONExtractString(output_json, 'diagnosis')\n        WHEN 'no_trading_history_due_to_new_system_init' THEN '  → 系统刚初始化,无交易历史'\n        WHEN 'no_trading_history_due_to_zero_decisions' THEN '  → 系统运行但未产生决策'\n        WHEN '' THEN '  → 正常运行'\n        ELSE concat('  → ', JSONExtractString(output_json, 'diagnosis'))\n    END\n) as '诊断详情'\nFROM llm.ai_brain_calls\nWHERE kind = 'propose_plan'\nORDER BY ts_ny DESC\nLIMIT 1\n",
          "refId": "A",
          "format": 1
        }
      ]
    },
