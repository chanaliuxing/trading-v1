SONExtractString(decision_json, 'action') as action,\n    count() as count\nFROM llm.llm_decisions\nWHERE toDate(ts_ny) = today()\n  AND symbol LIKE '${symbol}'\nGROUP BY action\nORDER BY count DESC\n","refId":"A"}],"title":"🎯 Decision Actions (决策分布)","type":"piechart"},{"datasource":{"type":"grafana-clickhouse-datasource","uid":"ch"},"gridPos":{"h":8,"w":8,"x":8,"y":16},"id":12,"options":{"bucketSize":0.1},"targets":[{"rawSql":"\nSELECT\n    toFloat64(JSONExtractString(decision_json, 'confidence')) as confidence\nFROM llm.llm_decisions\nWHERE toDate(ts_ny) = today()\n  AND symbol LIKE '${symbol}'\n  AND JSONExtractString(decision_json, 'confidence') != ''\n","refId":"A"}],"title":"📊 Confidence Distribution (置信度分布)","type":"histogram"},{"datasource":{"type":"grafana-clickhouse-datasource","uid":"ch"},"fieldConfig":{"overrides":[{"matcher":{"id":"byName","options":"ts_ny"},"properties":[{"id":"displayName","value":"Time"}]},{"matcher":{"id":"byName","options":"symbol"},"properties":[{"id":"displayName","value":"Symbol"}]},{"matcher":{"id":"byName","options":"action"},"properties":[{"id":"displayName","value":"Action"}]},{"matcher":{"id":"byName","options":"confidence"},"properties":[{"id":"displayName","value":"Confidence"},{"id":"decimals","value":2}]},{"matcher":{"id":"byName","options":"rationale"},"properties":[{"id":"displayName","value":"Rationale (Preview)"}]}]},"gridPos":{"h":8,"w":8,"x":16,"y":16},"id":13,"targets":[{"rawSql":"\nSELECT\n    ts_ny,\n    symbol,\n    JSONExtractString(decision_json, 'action') as action,\n    toFloat64(JSONExtractString(decision_json, 'confidence')) as confidence,\n    substring(JSONExtractString(decision_json, 'rationale'), 1, 50) as rationale\nFROM llm.llm_decisions\nWHERE toDate(ts_ny) = today()\n  AND symbol LIKE '${symbol}'\nORDER BY ts_ny DESC\nLIMIT 20\n","refId":"A"}],"title":"📝 Recent Decisions (最近决策)","type":"table"},{"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":24},"id":14,"title":"📦 Position Details (持仓详情)","