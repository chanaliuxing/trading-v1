 market_price) as market_value\nFROM llm.llm_positions_snapshot\nWHERE symbol LIKE '${symbol}'\nGROUP BY symbol\nHAVING anyLast(position) \u003e 0\nORDER BY market_value DESC\n","refId":"A"}],"title":"🥧 Position Distribution (持仓分布)","type":"piechart"},{"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":33},"id":17,"title":"📈 Equity Curve (权益曲线)","type":"row"},{"datasource":{"type":"grafana-clickhouse-datasource","uid":"ch"},"fieldConfig":{"defaults":{"custom":{"drawStyle":"line","fillOpacity":10,"lineInterpolation":"smooth"},"unit":"currencyUSD"},"overrides":[{"matcher":{"id":"byFrameRefID","options":"A"},"properties":[{"id":"displayName","value":"Equity"}]},{"matcher":{"id":"byFrameRefID","options":"B"},"properties":[{"id":"displayName","value":"Cash"}]}]},"gridPos":{"h":8,"w":18,"x":0,"y":34},"id":18,"targets":[{"rawSql":"\nSELECT\n    ts_ny as time,\n    equity\nFROM llm.llm_equity_timeseries\nWHERE toDate(ts_ny) = today()\nORDER BY ts_ny\n","refId":"A"},{"rawSql":"\nSELECT\n    ts_ny as time,\n    cash\nFROM llm.llm_equity_timeseries\nWHERE toDate(ts_ny) = today()\nORDER BY ts_ny\n","refId":"B"}],"title":"📈 Equity Timeseries (权益走势)","type":"timeseries"},{"datasource":{"type":"grafana-clickhouse-datasource","uid":"ch"},"fieldConfig":{"defaults":{"decimals":2,"max":0.3,"min":0,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"yellow","value":0.05},{"color":"orange","value":0.1},{"color":"red","value":0.2}]},"unit":"percentunit"}},"gridPos":{"h":8,"w":6,"x":18,"y":34},"id":19,"targets":[{"rawSql":"\nSELECT\n    anyLast(drawdown_to_date) as current_drawdown\nFROM llm.llm_equity_timeseries\nWHERE toDate(ts_ny) = today()\n","refId":"A"}],"title":"⚠️ Drawdown (回撤)","type":"gauge"}],"refresh":"30s","schemaVersion":39,"tags":["llm","trading","financial"],"templating":{"list":[{"auto":false,"current":{"text":"Today","value":"1d"},"label":"Time Range","name":"time_range","options":[{"text":"1h","value":"1h"},{"text":"6h","value":"6h"},{"select