 'diagnosis')\n    END as diagnosis_explained\nFROM llm.ai_brain_calls\nWHERE kind = 'propose_plan'\nORDER BY ts_ny DESC\nLIMIT 1","refId":"A"}],"title":"🩺 系统诊断 (Diagnosis)","type":"text"},{"datasource":{"type":"grafana-clickhouse-datasource","uid":"ch"},"description":"AI 提出的具体改进方案","fieldConfig":{"defaults":{"color":{"mode":"thresholds"},"custom":{"align":"left","cellOptions":{"type":"auto"},"inspect":false},"mappings":[],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]}},"overrides":[{"matcher":{"id":"byName","options":"confidence"},"properties":[{"id":"custom.width","value":100},{"id":"unit","value":"percentunit"},{"id":"custom.cellOptions","value":{"type":"color-background"}},{"id":"thresholds","value":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"yellow","value":0.5},{"color":"green","value":0.8}]}}]}]},"gridPos":{"h":6,"w":12,"x":12,"y":6},"id":5,"options":{"cellHeight":"sm","footer":{"countRows":false,"fields":"","reducer":["sum"],"show":false},"showHeader":true},"pluginVersion":"11.3.0","targets":[{"datasource":{"type":"grafana-clickhouse-datasource","uid":"ch"},"format":1,"meta":{"builderOptions":{"fields":[],"limit":100,"mode":"list"}},"queryType":"sql","rawSql":"WITH latest_plan AS (\n    SELECT output_json\n    FROM llm.ai_brain_calls\n    WHERE kind = 'propose_plan'\n    ORDER BY ts_ny DESC\n    LIMIT 1\n)\nSELECT\n    arrayJoin(JSONExtractArrayRaw((SELECT output_json FROM latest_plan), 'prescription')) as prescription_item,\n    JSONExtractString(prescription_item, 'action') as action,\n    JSONExtractFloat(prescription_item, 'confidence') as confidence,\n    JSONExtractString(prescription_item, 'params') as params\nFROM latest_plan","refId":"A"}],"title":"💊 AI 建议方案 (Prescription)","type":"table"},{"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":12},"id":6,"title":"⚙️ AI 决策执行 (decide)","type":"row"},{"datasource":{"type":"grafana-clickhouse-datasource","uid":"ch"},"description":"AI 最近执行的配置修改决策","fieldCon