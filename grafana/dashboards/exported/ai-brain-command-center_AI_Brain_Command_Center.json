) as count\nFROM llm.ai_brain_calls\nWHERE ts_ny \u003e= $__fromTime AND ts_ny \u003c= $__toTime\n  AND session != ''\nGROUP BY session\nORDER BY count DESC\n","refId":"A"}],"title":"📅 Calls by Session (按会话)","type":"barchart"},{"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":21},"id":14,"title":"📝 Latest Brain Plans (最新大脑计划)","type":"row"},{"datasource":{"type":"grafana-clickhouse-datasource","uid":"ch"},"fieldConfig":{"overrides":[{"matcher":{"id":"byName","options":"ts_ny"},"properties":[{"id":"displayName","value":"Time"}]},{"matcher":{"id":"byName","options":"session"},"properties":[{"id":"displayName","value":"Session"}]},{"matcher":{"id":"byName","options":"status"},"properties":[{"id":"displayName","value":"Status"}]},{"matcher":{"id":"byName","options":"providers"},"properties":[{"id":"displayName","value":"Providers"}]},{"matcher":{"id":"byName","options":"symbols"},"properties":[{"id":"displayName","value":"Symbols"}]},{"matcher":{"id":"byName","options":"safe_mode"},"properties":[{"id":"displayName","value":"Safe Mode"}]},{"matcher":{"id":"byName","options":"champion"},"properties":[{"id":"displayName","value":"Champion"}]},{"matcher":{"id":"byName","options":"challenger"},"properties":[{"id":"displayName","value":"Challenger"}]},{"matcher":{"id":"byName","options":"reasoning_profile"},"properties":[{"id":"displayName","value":"Reasoning"}]},{"matcher":{"id":"byName","options":"notes_preview"},"properties":[{"id":"displayName","value":"Notes"}]}]},"gridPos":{"h":8,"w":24,"x":0,"y":22},"id":15,"targets":[{"rawSql":"\nSELECT\n    ts_ny,\n    session,\n    status,\n    arrayStringConcat(providers, ', ') as providers,\n    arrayStringConcat(symbols, ', ') as symbols,\n    if(safe_mode, '🛡️ ON', '⚡ OFF') as safe_mode,\n    concat(toString(round(ab_champion * 100)), '%') as champion,\n    concat(toString(round(ab_challenger * 100)), '%') as challenger,\n    reasoning_profile,\n    substr(notes, 1, 100) as notes_preview\nFROM llm.ai_brain_plans\nWHERE ts_ny