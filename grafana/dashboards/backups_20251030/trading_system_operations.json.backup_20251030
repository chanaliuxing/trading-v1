      "fieldConfig": {
        "defaults": {
          "unit": "opm"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Throughput & Latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Inference Latency (ms, avg)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"trader\"} |= \"inference\" | json | run_id =~ \"$run_id\" | strategy_id =~ \"$strategy_id\" | unwrap ms | avg_over_time($__interval)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Order Volume (fills / rejects / trimmed)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(({job=\"trader\"} |= \"order_fill\" [1m])))",
          "legendFormat": "fills"
        },
        {
          "refId": "B",
          "expr": "sum by (event) (rate(({job=\"trader\"} |= \"order_rejected\" [1m])))",
          "legendFormat": "rejected"
        },
        {
          "refId": "C",
          "expr": "sum by (event) (rate(({job=\"trader\"} |= \"order_trimmed\" [1m])))",
          "legendFormat": "trimmed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "type": "row",
      "title": "End-to-End Performance",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "SLO Metrics (from ClickHouse)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT toDateTime(ts_ms/1000) AS t, data_lag_ms_avg AS v FROM trading.live_metrics ORDER BY t",
          "format": "time_series",
          "legendFormat": "data_lag",
          "queryType": "sql",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          }
        },
        {
          "refId": "B",
          "query": "SELECT toDateTime(ts_ms/1000) AS t, slippage_bps_avg AS v FROM trading.live_metrics ORDER BY t",
          "format": "time_series",
          "legendFormat": "slippage_bps",
          "queryType": "sql",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 60
    },
    {
      "type": "timeseries",
      "title": "Error Rates (from ClickHouse)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ch"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 10,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT toDateTime(ts_ms/1000) AS t, order_error_rate AS v FROM trading.live_metrics ORDER BY t",
          "format": "time_series",
          "legendFormat": "order_error_rate",
          "queryType": "sql",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ch"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 61
    },
    {
      "id": 62,
      "type": "text",
      "title": "Telemetry Gaps",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 15
      },
      "options": {
        "mode": "markdown",
        "content": "* Kafka lag metrics not yet exported.\n* service_up only tracks TradingSystem.\n* Consider adding Redis/Postgres exporters for infra coverage."
      }
    },
    {
      "type": "row",
      "title": "Why Not & Diagnostics",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Why Not Order? \u2014 Reasons over Time (stacked)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (count_over_time({job=\"trader\"} |~ \"order_skipped|order_rejected|overlay_block\" | json | run_id =~ \"$run_id\" | strategy_id =~ \"$strategy_id\" | reason != \"\" [$__interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 30,
      "type": "table",
      "title": "Top Reasons (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (reason) (count_over_time({job=\"trader\"} |~ \"order_skipped|order_rejected|overlay_block\" | json | run_id =~ \"$run_id\" | strategy_id =~ \"$strategy_id\" [${__range_s}s])))",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 31,
      "type": "table",
      "title": "Top Blocking Symbols (range)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (symbol) (count_over_time({job=\"trader\"} |~ \"order_rejected|order_trimmed|overlay_block\" | json | run_id =~ \"$run_id\" | strategy_id =~ \"$strategy_id\" [${__range_s}s])))",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      }
