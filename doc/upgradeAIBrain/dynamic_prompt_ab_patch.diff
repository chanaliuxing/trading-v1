+def _prepare_prompt_overrides(self, plan: dict) -> dict:
+    """Persist any execution_prompt_text to file and return per-provider overrides.
+
+    Returns a dict: {provider_index: {"PROMPT_ID": "...", "PROMPT_FILE": "..."}}.
+    Obeys policies.prompts.allow_text_override (default: false).
+    """
+    allow_text = bool((self.cfg.get("policies", {}).get("prompts", {}) or {}).get("allow_text_override", False))
+    out: dict[int, dict] = {}
+    providers = (plan or {}).get("providers") or []
+    dstr = datetime.date.today().isoformat()
+    out_dir = self.runs_dir / dstr / "prompts"
+    out_dir.mkdir(parents=True, exist_ok=True)
+    ts = datetime.datetime.now(self.ny_tz).strftime("%H-%M-%S")
+    for i, p in enumerate(providers):
+        entry = {}
+        eid = p.get("execution_prompt_id") or None
+        etx = p.get("execution_prompt_text") or None
+        if eid:
+            entry["PROMPT_ID"] = str(eid)
+        if allow_text and etx:
+            fp = out_dir / f"prov{i}_{p.get('name','prov')}_{ts}.txt"
+            try:
+                fp.write_text(str(etx), encoding="utf-8")
+                entry["PROMPT_FILE"] = str(fp)
+            except Exception:
+                pass
+        if entry:
+            out[i] = entry
+    return out
