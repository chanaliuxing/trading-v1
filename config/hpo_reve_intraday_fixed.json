{
  "hpo": {
    "symbols": ["TSLA", "NVDA", "AAPL"],
    "start": "2024-07-01 09:30:00",
    "end": "2024-12-01 16:00:00",
    "interval_sec": 60,
    "timeframe": "1m",
    "features_table": "trading.features_1m",

    "clickhouse": {
      "host": "localhost",
      "port": 8123,
      "username": "default",
      "password": "",
      "database": "trading"
    },

    "strategy_path": "strategies.reve_intraday_strategy.RevEIntradayStrategyV2",
    "strategy_base_extras": {
      "universe": ["TSLA", "NVDA", "AAPL"],
      "risk": {
        "per_trade_pct": 0.0025,
        "per_trade_pct_low": 0.0020,
        "max_concurrent_positions": 3,
        "max_daily_loss_pct": 0.04
      },
      "schedule": {
        "market_open_pt": "06:30:00",
        "last_entry_pt": "12:00:00",
        "force_flat_pt": "12:50:00"
      },
      "gating": {
        "p_up_uptrend": 0.80,
        "p_up_downtrend": 0.30,
        "trend_push_threshold": 0.15
      },
      "exec": {
        "entry_buffer_atr": 0.10,
        "protective_flat_atr": 0.15,
        "tick_size_default": 0.01
      }
    },

    "initial_cash": 100000.0,
    "commission_rate": 0.0001,
    "slippage_rate": 0.0001,

    "fold_generator": {
      "start": "2024-07-01 09:30:00",
      "end": "2024-12-01 16:00:00",
      "is_days": 60,
      "oos_days": 30,
      "gap_days": 2,
      "step_days": 30,
      "embargo_days": 2
    },

    "folds": [
      {
        "fold_id": 1,
        "is_start": "2024-07-01 09:30:00",
        "is_end":   "2024-09-01 16:00:00",
        "oos_start":"2024-09-03 09:30:00",
        "oos_end":  "2024-10-01 16:00:00",
        "purge_days": 2,
        "embargo_days": 2
      },
      {
        "fold_id": 2,
        "is_start": "2024-08-01 09:30:00",
        "is_end":   "2024-10-01 16:00:00",
        "oos_start":"2024-10-03 09:30:00",
        "oos_end":  "2024-11-01 16:00:00",
        "purge_days": 2,
        "embargo_days": 2
      },
      {
        "fold_id": 3,
        "is_start": "2024-09-01 09:30:00",
        "is_end":   "2024-11-01 16:00:00",
        "oos_start":"2024-11-03 09:30:00",
        "oos_end":  "2024-12-01 16:00:00",
        "purge_days": 2,
        "embargo_days": 2
      }
    ],

    "grid": {
      "strategy_A.near_vwap_atr": [0.15, 0.20, 0.25],
      "strategy_A.sl_atr": [0.40, 0.50, 0.60],
      "strategy_A.tp1_atr": [0.80, 1.00, 1.20],
      "strategy_A.trail_atr": [0.80, 1.00, 1.20],
      "strategy_A.ewma_alpha": [0.65, 0.70, 0.75],
      "strategy_A.band_clip_low_atr": [0.50, 0.60, 0.70],
      "strategy_A.band_clip_high_atr": [1.30, 1.40, 1.50],
      "strategy_A.q_level": [0.75, 0.80, 0.85],
      "strat_B_sl_atr5m": [0.30, 0.40, 0.50],
      "strat_B_pullback_threshold": [0.60, 0.80, 1.00]
    },

    "objective": {
      "metric": "sharpe",
      "maximize": true,
      "min_trades": 10,
      "max_mdd": 0.35,
      "min_pnl": -5000,
      "formula": null
    },

    "overlay_config": {
      "max_position_pct": 0.25,
      "max_gross_exposure": 1.0,
      "max_net_exposure": 0.8,
      "max_drawdown_halt": 0.20,
      "volatility_lookback": 20,
      "volatility_target": 0.15,
      "vol_scaling_enabled": false
    },

    "parallel": {
      "enabled": true,
      "workers": 4
    }
  },

  "ml": {
    "n_points": 16
  },

  "llm": {
    "provider": "openai",
    "model": "gpt-4"
  },

  "heuristic": {
    "widen": 0.2
  },

  "coop": {
    "cap_per_param": 5
  },

  "guard": {
    "max_combinations": 10000,
    "max_values_per_param": 10,
    "param_range_multiplier": 5.0
  },

  "run_id": "reve_ml_${DATE}",

  "comments": {
    "strategy_A": "VWAP mean reversion strategy - buys near/below VWAP with dynamic band",
    "strategy_B": "ORB breakout recovery strategy - buys on pullback after ORB low break",
    "key_params": {
      "near_vwap_atr": "How close to VWAP to trigger entry (in ATR units)",
      "sl_atr": "Stop loss distance (in ATR units)",
      "tp1_atr": "First take profit target (in ATR units)",
      "trail_atr": "Trailing stop distance after TP1 (in ATR units)",
      "ewma_alpha": "Smoothing factor for EWMA band calculation",
      "band_clip_low_atr": "Lower bound for dynamic band (in ATR units)",
      "band_clip_high_atr": "Upper bound for dynamic band (in ATR units)",
      "q_level": "Quantile level for VWAP deviation calculation",
      "strat_B_sl_atr5m": "ORB strategy stop loss (in 5m ATR units)",
      "strat_B_pullback_threshold": "Max pullback depth for ORB entry (in ATR units)"
    }
  }
}
