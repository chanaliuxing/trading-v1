{
  "defaults": {
    "is_days": 45,
    "oos_days": 1,
    "step_days": 1,
    "horizon_min": 30,
    "label_bps": 15,
    "auto_heal": true,
    "drop_flat": false,
    "rth_only": true,
    "exclude_open_min": 5,
    "min_is_rows": 200,
    "algo": "baseline",
    "xgb": {
      "n_estimators": 500,
      "max_depth": 5,
      "learning_rate": 0.05,
      "min_child_weight": 3,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "reg_lambda": 1.0,
      "reg_alpha": 0.1,
      "scale_pos_weight": "auto"
    }
  },
  "models": {
    "xgb": {
      "horizon_min": 30
    },
    "lstm": {
      "algo": "baseline",
      "min_is_rows": 50,
      "lookback": 60,
      "hidden": 128,
      "num_layers": 2,
      "dropout": 0.2,
      "epochs": 100,
      "patience": 10
    }
  },
  "symbols": {
    "TSLA": {
      "xgb": {
        "label_bps": 10
      }
    },
    "AAPL": {
      "xgb": {
        "label_bps": 10
      },
      "lstm": {
        "exclude_open_min": 10
      }
    }
  }
}