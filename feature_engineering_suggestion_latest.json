            "num": "ret_1",
            "den": "atr_14",
            "eps": 1e-06
          },
          {
            "name": "feat_log_volume",
            "op": "log1p",
            "col": "volume"
          },
          {
            "name": "feat_ret_1m_roll_10",
            "op": "rolling_sum",
            "col": "ret_1",
            "window_bars": 10,
            "min_periods": 3,
            "per_symbol": true
          },
          {
            "name": "feat_price_impact",
            "op": "price_impact_hl",
            "per_symbol": true
          },
          {
            "name": "feat_effective_spread",
            "op": "effective_spread",
            "eps": 1e-06
          },
          {
            "name": "feat_vol_20",
