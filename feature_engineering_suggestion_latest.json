            "col": "ret_1",
            "window_bars": 20,
            "min_periods": 5,
            "per_symbol": true
          },
          {
            "name": "feat_momo_vol_ratio",
            "op": "ratio",
            "num": "feat_ret_1m_roll_10",
            "den": "feat_vol_20",
            "eps": 1e-06
          },
          {
            "name": "feat_effspread_roll10",
            "op": "rolling_mean",
            "col": "feat_effective_spread",
            "window_bars": 10,
            "min_periods": 3,
            "per_symbol": true
          },
          {
            "name": "feat_vwap_vol_interact",
            "op": "product",
            "col1": "feat_vwap_dev",
            "col2": "feat_log_volume"
          }
        ]
      }
    },
    "delete": [
      "momentum_v1"
    ]
